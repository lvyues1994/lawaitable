{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "AW_TEST_CXX_STANDARD": "14" }
        },
        { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        {
            "name": "asan",
            "displayName": "ASan + UBSan",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g"
            }
        },
        {
            "name": "tsan",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g"
            }
        },
        { "name": "debug-cxx17", "inherits": "debug", "cacheVariables": { "AW_TEST_CXX_STANDARD": "17" } },
        { "name": "debug-cxx20", "inherits": "debug", "cacheVariables": { "AW_TEST_CXX_STANDARD": "20" } },
        {
            "name": "cross-base",
            "hidden": true,
            "inherits": "base",
            "description": "交叉编译只构建库和测试可执行文件；测试在目标机上运行。C++ 标准用 -DAW_TEST_CXX_STANDARD=14/17/20 选"
        },
        {
            "name": "qnx-aarch64le-base",
            "hidden": true,
            "inherits": "cross-base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/qnx710-aarch64le.cmake"
        },
        { "name": "qnx-aarch64le-debug", "displayName": "QNX 7.1 aarch64le Debug (source qnxsdp-env.sh first)", "inherits": "qnx-aarch64le-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "qnx-aarch64le-release", "displayName": "QNX 7.1 aarch64le Release (source qnxsdp-env.sh first)", "inherits": "qnx-aarch64le-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        {
            "name": "qnx-x86_64-release",
            "displayName": "QNX 7.1 x86_64 Release (source qnxsdp-env.sh first)",
            "inherits": "cross-base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/qnx710-x86_64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "android-base",
            "hidden": true,
            "inherits": "cross-base",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": { "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-24", "ANDROID_STL": "c++_shared" }
        },
        { "name": "android-arm64-debug", "displayName": "Android arm64-v8a Debug (needs ANDROID_NDK)", "inherits": "android-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "android-arm64-release", "displayName": "Android arm64-v8a Release (needs ANDROID_NDK)", "inherits": "android-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "android-x86_64-release", "displayName": "Android x86_64 Release, emulator (needs ANDROID_NDK)", "inherits": "android-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ANDROID_ABI": "x86_64" } }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "tsan", "configurePreset": "tsan" },
        { "name": "debug-cxx17", "configurePreset": "debug-cxx17" },
        { "name": "debug-cxx20", "configurePreset": "debug-cxx20" },
        { "name": "qnx-aarch64le-debug", "configurePreset": "qnx-aarch64le-debug" },
        { "name": "qnx-aarch64le-release", "configurePreset": "qnx-aarch64le-release" },
        { "name": "qnx-x86_64-release", "configurePreset": "qnx-x86_64-release" },
        { "name": "android-arm64-debug", "configurePreset": "android-arm64-debug" },
        { "name": "android-arm64-release", "configurePreset": "android-arm64-release" },
        { "name": "android-x86_64-release", "configurePreset": "android-x86_64-release" }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true },
            "environment": { "ASAN_OPTIONS": "detect_leaks=0", "UBSAN_OPTIONS": "print_stacktrace=1" }
        },
        { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
        { "name": "debug-cxx17", "configurePreset": "debug-cxx17", "output": { "outputOnFailure": true } },
        { "name": "debug-cxx20", "configurePreset": "debug-cxx20", "output": { "outputOnFailure": true } }
    ]
}
