+// whenAll 两个同步完成的子 Task：两个子帧 + awaiter（超出 awaiter 槽时在堆上）+ stop 状态。
+auto awaitsWhenAll(int n)
+    CO2_BEG(co2::Task<long>, (n), int i{}; long total{}; std::tuple<int, int> pair{};) {
+    for (i = 0; i < n; ++i) {
+        CO2_AWAIT_SET(pair, co2::whenAll(leaf(i), leaf(i)));
+        total += std::get<0>(pair) + std::get<1>(pair);
+    }
+    CO2_RETURN(total);
+}
+CO2_END
+
+double whenAllTwoReadyTasks() {
+    constexpr int ops = 2000000;
+    return nanosecondsPerOp(static_cast<std::size_t>(ops),
+                            [&] { sink = co2::syncWait(awaitsWhenAll(ops)); });
+}
+
 // 多个线程各自跑一条"等待子 Task"的循环。sharedToken 为真时所有线程的 Task 树共用同一个
 // stop_token——whenAll / spawn 的各个分支落在不同线程上时就是这种形态。
