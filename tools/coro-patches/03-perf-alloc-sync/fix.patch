diff --git a/include/co2/sync_wait.hpp b/include/co2/sync_wait.hpp
index 955b6e2..0f4f9c1 100644
--- a/include/co2/sync_wait.hpp
+++ b/include/co2/sync_wait.hpp
@@ -1,5 +1,6 @@
 #pragma once
 
+#include <atomic>
 #include <condition_variable>
 #include <mutex>
 #include <type_traits>
@@ -14,22 +15,36 @@
 namespace co2 {
 namespace detail {
 
+// 完成与等待的握手。快路径：Task 在 start() 里同步完成（或在等待线程开始等待之前完成）时，
+// 双方只各做一次原子操作，不碰 mutex / condition_variable。慢路径：等待线程先在锁内把
+// 状态从 running 改成 parked 再睡；完成方看到 parked 才拿锁通知。
 struct SyncWaitState {
+    enum : unsigned char { running, finished, parked };
+
+    std::atomic<unsigned char> phase{running};
     std::mutex mutex;
     std::condition_variable wakeup;
-    bool finished{};
+    bool notified{}; // 慢路径的谓词，受 mutex 保护
 
     void markFinished() noexcept {
-        // 在锁内通知：state 住在 syncWait 的栈上，等待线程一旦看到 finished
-        // 就会销毁它。
+        if (phase.exchange(finished, std::memory_order_acq_rel) != parked) return;
+        // 在锁内通知：state 住在 syncWait 的栈上，等待线程一旦看到 notified
+        // 就会销毁它。等待线程只认锁内写的 notified，不认 phase，所以不会在这里
+        // 还没放开锁时提前返回。
         std::lock_guard<std::mutex> lock{mutex};
-        finished = true;
+        notified = true;
         wakeup.notify_one();
     }
 
     void wait() {
+        if (phase.load(std::memory_order_acquire) == finished) return;
         std::unique_lock<std::mutex> lock{mutex};
-        wakeup.wait(lock, [this] { return finished; });
+        auto expected = static_cast<unsigned char>(running);
+        if (not phase.compare_exchange_strong(expected, parked,
+                                              std::memory_order_acq_rel,
+                                              std::memory_order_acquire))
+            return; // 期间已经完成：完成方没有看到 parked，不会再碰 mutex
+        wakeup.wait(lock, [this] { return notified; });
     }
 };
 
