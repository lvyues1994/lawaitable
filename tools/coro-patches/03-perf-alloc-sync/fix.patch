@@ -211,6 +229,22 @@ double threadPoolHopSaturated() { return threadPoolHops(4U, 32, 100000); }
 // 不饱和：一个 Task 在 8 个工作线程的池里反复让步，其余 7 个线程无事可做。
 double threadPoolHopUnsaturated() { return threadPoolHops(8U, 1, 1000000); }
 
+// 同线程的 spawn + join：没有跨线程唤醒，剩下的是 spawn 自身的开销（帧、JoinState、
+// stop 状态三次分配与 JoinState 的锁）。
+double spawnAndJoinManualExecutor() {
+    constexpr int ops = 1000000;
+    co2::ManualExecutor executor;
+    return nanosecondsPerOp(static_cast<std::size_t>(ops), [&] {
+        long total = 0;
+        for (auto index = 0; index != ops; ++index) {
+            auto handle = co2::spawn(executor, leaf(index));
+            executor.run();
+            total += handle.join();
+        }
+        sink = total;
+    });
+}
+
 double spawnAndJoin() {
     constexpr int ops = 20000;
     co2::ThreadPool pool{1U};
