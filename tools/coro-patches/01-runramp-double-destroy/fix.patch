+// 同上，但返回对象拥有帧（析构时 destroy()，Task 式的常见写法）：初始挂起点之前的异常
+// 只能销毁协程状态一次。修复前 runRamp 先析构返回对象（它销毁帧），guard 再销毁一次。
+struct OwningThrowingInitialTask {
+    struct promise_type {
+        EventLog* log{};
+        int throwAt{};
+        promise_type(EventLog& log_, int const throwAt_, Tracked&)
+            : log{&log_}, throwAt{throwAt_} {}
+        promise_type() = default;
+        ~promise_type() {
+            if (log != nullptr) log->add("promise destroyed");
+        }
+        OwningThrowingInitialTask get_return_object() {
+            return OwningThrowingInitialTask{
+                co2::coroutine_handle<promise_type>::from_promise(*this)};
+        }
+        T::Throwing initial_suspend() { return T::Throwing{log, throwAt}; }
+        co2::suspend_always final_suspend() noexcept { return {}; }
+        void return_void() {}
+        void unhandled_exception() { log->add("unhandled_exception"); }
+    };
+
+    explicit OwningThrowingInitialTask(co2::coroutine_handle<promise_type> h) : handle{h} {}
+    OwningThrowingInitialTask(OwningThrowingInitialTask&& other) noexcept
+        : handle{other.handle} {
+        other.handle = nullptr;
+    }
+    ~OwningThrowingInitialTask() {
+        if (handle) handle.destroy();
+    }
+
+    co2::coroutine_handle<promise_type> handle;
+};
+
+auto owningThrowsBeforeInitialResume(EventLog& log, int throwAt, Tracked param)
+    CO2_BEG(OwningThrowingInitialTask, (log, throwAt, param)) {
+    log.add("body");
+}
+CO2_END
+
+void exceptionsBeforeTheInitialAwaitResumeDestroyAnOwnedFrameOnce() {
+    // await_ready、await_suspend 抛出（get_return_object 已经返回了拥有帧的对象）。
+    for (auto const throwAt : {1, 2}) {
+        EventLog log;
+        auto propagated = false;
+        try {
+            owningThrowsBeforeInitialResume(log, throwAt, Tracked{log, "param"});
+        } catch (std::runtime_error const&) {
+            propagated = true;
+        }
+        CHECK(propagated);
+        checkDestroyedWithoutRunning(log);
+        auto destroyed = 0;
+        for (auto const& event : log.events) {
+            if (event == "promise destroyed") ++destroyed;
+        }
+        CHECK(destroyed == 1);
+    }
+}
